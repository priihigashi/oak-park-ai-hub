{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "edit_decision.schema.json",
  "title": "EditDecision",
  "description": "Shared contract connecting shot planning → approval → Remotion render for Content Creator V2",
  "type": "object",
  "required": ["project_id", "shots", "audio", "render_config"],
  "additionalProperties": false,
  "properties": {
    "project_id": {
      "type": "string",
      "description": "Unique project identifier, e.g. opc-2026-10-roof-tips"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/ShotRequest" }
    },
    "audio": {
      "$ref": "#/definitions/AudioConfig"
    },
    "render_config": {
      "$ref": "#/definitions/RenderConfig"
    }
  },
  "definitions": {
    "ShotRequest": {
      "type": "object",
      "required": ["shot_id", "beat_label", "description", "duration_sec"],
      "additionalProperties": false,
      "properties": {
        "shot_id": {
          "type": "string",
          "description": "Matches beat/frame ID in storyboard, e.g. S01"
        },
        "beat_label": {
          "type": "string",
          "description": "Human-readable beat name, e.g. Hook, Problem, Reveal"
        },
        "description": {
          "type": "string",
          "description": "What should be seen in this shot"
        },
        "duration_sec": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "source_candidates": {
          "type": "array",
          "description": "Ordered list of asset file paths or media catalog IDs to try",
          "items": { "type": "string" }
        },
        "approved_asset_id": {
          "type": ["string", "null"],
          "description": "SHA256 hash of the approved asset from media_catalog.db; null = not yet approved"
        },
        "replacement_note": {
          "type": ["string", "null"],
          "description": "Human note if the first candidate was replaced"
        }
      }
    },
    "AudioConfig": {
      "type": "object",
      "required": ["source"],
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string",
          "description": "Path to audio file or 'tts' for synthesized voiceover"
        },
        "volume": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 1
        },
        "start_offset_sec": {
          "type": "number",
          "default": 0
        }
      }
    },
    "RenderConfig": {
      "type": "object",
      "required": ["width", "height", "fps"],
      "additionalProperties": false,
      "properties": {
        "width": { "type": "integer", "enum": [1080, 1920] },
        "height": { "type": "integer", "enum": [1080, 1920] },
        "fps": { "type": "integer", "enum": [24, 30, 60] },
        "output_format": {
          "type": "string",
          "enum": ["mp4", "webm"],
          "default": "mp4"
        },
        "codec": {
          "type": "string",
          "enum": ["h264", "h265", "vp9"],
          "default": "h264"
        }
      }
    }
  }
}
