{
  "$comment": "Project standards for the Junior Architect Pipeline (by Abhinav Bhardwaj). `jap init` copies this to .jap/project.json and every checker reads it. Defaults are starting points and placeholders, not your jurisdiction's rules: replace each one from the office standard or a checked code-research run.",
  "project": "Project name",
  "jurisdiction": "City, country",
  "stage": "2",


  "model_units": "mm",
  "allow_imperial": false,
  "area_definition": "internal",
  "area_standard": "State the standard you measure to, e.g. IPMS 3 / RICS NIA / DIN 277 NRF / ANSI-BOMA Z65.1",
  "area_tolerance_pct": 5,
  "rooms_layer": "ROOMS",
  "code_documents": ["List each code and edition in force"],

  "stair_rules": {
    "$comment": "PLACEHOLDERS. Replace per use from quoted clauses of the code in force.",
    "default": {"blondel_min": 600, "blondel_max": 650, "max_riser_mm": 180, "min_going_mm": 260, "min_width_mm": 1100, "min_headroom_mm": 2100, "max_flight_risers": 16, "max_pitch_deg": 38},
    "private": {"blondel_min": 550, "blondel_max": 700, "max_riser_mm": 220, "min_going_mm": 220, "min_width_mm": 800, "max_pitch_deg": 42}
  },
  "fabrication": {"max_w_mm": 3000, "max_h_mm": 4200, "min_w_mm": 300, "min_h_mm": 300, "max_types": 12, "max_planarity_mm": 5, "stock": [{"w_mm": 2440, "h_mm": 1220}, {"w_mm": 3000, "h_mm": 1500}]},

  "view_requirements": {"levels": [], "min_sections": 2, "min_elevations": 4, "scales": {"FloorPlan": [50, 100, 200], "Section": [50, 100, 200], "Elevation": [50, 100, 200], "Detail": [5, 10, 20]}, "require_template": true, "require_on_sheet": ["FloorPlan", "Section", "Elevation", "Detail"]},
  "tag_coverage": {"Doors": 1, "Windows": 1, "Rooms": 1},

  "cad": {"layer_pattern": "^[A-Z]-[A-Z0-9]{2,4}(-[A-Z0-9]{2,4}){0,2}$", "insunits": 4, "plot_scale": 100, "text_heights_mm": [1.8, 2.5, 3.5, 5, 7, 10]},
  "render": {"min_width": 3000, "eye_level_m": [1.5, 1.75], "focal_mm": [24, 50], "sun_tolerance_deg": 2, "browser": "C:/Program Files/Google/Chrome/Application/chrome.exe"},
  "site": {"lat": null, "lon": null, "tz": null, "true_north_deg": null},

  "clash_tolerance_mm": 10,
  "ifc_schema": "IFC4X3",
  "quantity_units": {},

  "sheet_name_pattern": "^[A-Z0-9]{2,6}-[A-Z0-9]{2,6}-[A-Z0-9]{2,3}-[A-Z0-9]{2,3}-[A-Z]{2}-[A-Z]-\\d{4,6}$",
  "sheet_ref_pattern": "\\b[A-Z0-9]{2,6}-[A-Z0-9]{2,6}-[A-Z0-9]{2,3}-[A-Z0-9]{2,3}-[A-Z]{2}-[A-Z]-\\d{4,6}\\b",
  "status_codes": ["S0", "S1", "S2", "S3", "S4", "S6", "S7", "A\\d+", "B\\d+", "CR"],
  "required_fields": {
    "doors": ["mark", "type", "level", "width_mm", "height_mm", "fire_rating", "ironmongery_set"],
    "windows": ["mark", "type", "level", "width_mm", "height_mm", "u_value", "g_value"],
    "rooms": ["number", "name", "level", "area_m2", "floor_finish", "wall_finish", "ceiling_finish", "ceiling_height_mm"],
    "levels": ["name", "elevation_mm"],
    "families": ["name", "category", "type"],
    "materials": ["name", "product", "colour"],
    "sheets": ["number", "title", "revision", "status", "drawn_by", "checked_by", "date"],
    "audit": ["id"]
  },
  "escalation": "Anything touching code compliance, fire, structure, contract or cost goes to a named senior before it leaves the office."
}
