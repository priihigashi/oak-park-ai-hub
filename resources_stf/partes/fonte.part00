<!doctype html><html><head><meta charset=utf8><meta name=viewport content="width=device-width,initial-scale=1"><style>:root{color-scheme:light}body{margin:0;padding:0;font:14px -apple-system,BlinkMacSystemFont,sans-serif;background:#fff;color:#000}img{max-width:100%}[hidden]:not([hidden=until-found i]){display:none!important}</style></head><body>
<!doctype html><html lang="pt-BR"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Uma cadeira vazia no Supremo</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Rubik:wght@400;600;800;900&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
<style>
/* Prévia da automação (regras dela): tamanho de celular, voz sincronizada, play/busca, pular 5/10/30 s,
   velocidades 1 / 1,05 / 1,1 / 1,2 / 1,5 / 2 / 3, caixa de notas com copiar (começa com título, ID e link),
   download, legenda e primeiro comentário prontos pra copiar. Sem MP4: a cena é desenhada no tempo do áudio. */
:root{--bg:#0B0B0C;--fg:#F2EEE6;--mut:#9a958c;--ac:#4ADE80}
*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--fg);font-family:Rubik,system-ui,sans-serif}
.wrap{display:grid;grid-template-columns:minmax(0,420px) minmax(0,1fr);gap:28px;max-width:1100px;margin:0 auto;padding:20px}
@media(max-width:820px){.wrap{grid-template-columns:minmax(0,1fr);padding:12px}}
.meta{overflow-wrap:anywhere;font-family:"JetBrains Mono",monospace;font-size:11px;text-transform:uppercase;letter-spacing:.08em;color:var(--mut)}
h1{font-weight:900;font-size:clamp(22px,3vw,32px);margin:6px 0 4px;line-height:1.05}
.palcoBox{position:relative;width:min(100%,calc((100vh - 230px) * 9 / 16));min-width:260px;aspect-ratio:9/16;border-radius:14px;overflow:hidden;background:#111}
#palco{position:absolute;inset:0;transform-origin:0 0}
.cena{position:absolute;inset:0;display:flex;flex-direction:column;justify-content:center;padding:54px 54px 260px}
.t{font-weight:900;font-size:46px;line-height:1.05;text-transform:uppercase}
.q{font-weight:800;font-size:34px;line-height:1.15}
.bar{display:flex;align-items:center;gap:10px;margin:8px 0;font-weight:800;font-size:20px}.bar i{display:block;height:26px;border-radius:6px}
.fonte{position:absolute;left:54px;right:54px;bottom:24px;font-size:13px;opacity:.85}
.leg{position:absolute;left:54px;right:54px;bottom:120px;font-weight:900;font-size:26px;line-height:1.2;color:#fff;text-align:center;
  -webkit-text-stroke:1.2px #111;paint-order:stroke fill;text-shadow:0 2px 8px rgba(0,0,0,.85)}.leg b{color:#FFD34D}
.ctl{display:flex;flex-wrap:wrap;gap:6px;margin:10px 0;align-items:center}
button,.btn{font-family:Rubik,system-ui,sans-serif;font-weight:800;font-size:13px;border:1px solid #333;background:#17171a;color:var(--fg);border-radius:10px;padding:9px 12px;cursor:pointer;text-decoration:none}
button.on{background:var(--ac);color:#111;border-color:var(--ac)}
input[type=range]{width:100%;accent-color:var(--ac)}
.card{border:1px solid #26262a;border-radius:14px;padding:14px;margin-bottom:12px;background:#121214}
.card h2{font-size:13px;font-weight:800;text-transform:uppercase;letter-spacing:.06em;margin:0 0 8px}
textarea{width:100%;min-height:110px;background:#0e0e10;color:var(--fg);border:1px solid #2a2a2e;border-radius:10px;padding:10px;font:15px Rubik,system-ui,sans-serif}
pre{white-space:pre-wrap;font:14px/1.45 Rubik,system-ui,sans-serif;margin:0}
.selo{display:inline-block;background:var(--ac);color:#111;font-weight:800;border-radius:8px;padding:3px 8px;font-size:12px}
</style><style>@font-face{font-family:'Rubik';font-weight:400;src:url(data:font/woff2;base64,) format('woff2')}
@font-face{font-family:'Rubik';font-weight:600;src:url(data:font/woff2;base64,) format('woff2')}
@font-face{font-family:'Rubik';font-weight:800;src:url(data:font/woff2;base64,) format('woff2')}
@font-face{font-family:'Rubik';font-weight:900;src:url(data:font/woff2;base64,) format('woff2')}
@font-face{font-family:'JetBrains Mono';font-weight:700;src:url(data:font/woff2;base64,) format('woff2')}
@font-face{font-family:'Anton';font-weight:400;src:url(data:font/woff2;base64,) format('woff2')}
@font-face{font-family:'DM Serif Display';font-weight:400;src:url(data:font/woff2;base64,) format('woff2')}
@font-face{font-family:'Inter Tight';font-weight:700;src:url(data:font/woff2;base64,) format('woff2')}
@font-face{font-family:'JetBrains Mono';font-weight:400;src:url(data:font/woff2;base64,) format('woff2')}
@font-face{font-family:'Patrick Hand SC';font-weight:400;src:url(data:font/woff2;base64,) format('woff2')}</style><script>window.IMG={"messias": "data:image/webp;base64,", "messias_h": "data:image/webp;base64,", "estela": "data:image/webp;base64,", "estela_h": "data:image/webp;base64,", "edilene": "data:image/webp;base64,", "edilene_h": "data:image/webp;base64,", "elizabeth": "data:image/webp;base64,", "elizabeth_h": "data:image/webp;base64,", "veronica": "data:image/webp;base64,", "veronica_h": "data:image/webp;base64,", "presidente": "data:image/webp;base64,", "presidente_h": "data:image/webp;base64,", "f_stf_plen": "data:image/webp;base64,", "f_tse_plen": "data:image/webp;base64,", "messias_cab": "data:image/webp;base64,