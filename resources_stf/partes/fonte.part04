.cpalco .p-el.cab.f2{filter:blur(3.5px) grayscale(1);opacity:.55;z-index:2}
.cpalco .p-el.cab.topo{filter:grayscale(1) contrast(1.1);z-index:4}
.cpalco .p-ponte{position:absolute;left:0;right:0;top:1250px;height:300px;z-index:5;pointer-events:none}
`;

  // campos mínimos de cada card do Painel (sem eles a cena fica no card que o modelo escolheu)
  const PSCHEMA = { p81: ['titulo'], p82: ['titulo'], p83: ['titulo'], p84: ['titulo'], p85: ['titulo'], p86: ['titulo', 'pessoa'], p114: ['titulo'], p115: ['titulo'], p116: ['titulo'], p117: ['titulo'], p119: ['titulo'], p142: ['titulo'], p41: ['titulo'], p125: ['titulo', 'itens'], p137: ['titulo', 'itens'], p148: ['titulo', 'pessoa'], p149: ['titulo', 'pessoa'], p150: ['titulo', 'pessoas'], p151: ['titulo', 'pessoas'], p152: ['titulo', 'pessoa'],
    p89: ['titulo'], p134: ['titulo'], p79: ['titulo', 'barras'], p92: ['titulo', 'itens'], p112: ['titulo', 'itens'],
    p118: ['titulo', 'citacao'], p98: ['titulo', 'itens'], p143: ['titulo', 'pessoa'], p160: ['titulo', 'pessoa'], p162: ['titulo', 'pessoas'] };
  // cena feita pro livre/acervo também serve: blocos viram campos (titulo, apoio, itens, pessoas, citacao, numero)
  function pCampos(c) {
    const o = { ...(c || {}) };
    for (const b of Array.isArray(o.blocos) ? o.blocos : []) { if (!b || typeof b !== 'object') continue;
      if (b.tipo === 'titulo' && !o.titulo) { o.titulo = b.texto; if (!o.destaque) o.destaque = b.destaque; }
      else if (b.tipo === 'texto' && !o.apoio) o.apoio = b.texto;
      else if (b.tipo === 'itens' && !o.itens) o.itens = b.itens;
      else if (b.tipo === 'pessoas' && !o.pessoas) o.pessoas = b.pessoas;
      else if (b.tipo === 'citacao' && !o.citacao) { o.citacao = b.texto; if (!o.autor) o.autor = b.autor; }
      else if (b.tipo === 'etiqueta' && !o.rotulo) o.rotulo = b.texto; }
    if (!o.pessoa && Array.isArray(o.pessoas) && o.pessoas[0]) o.pessoa = o.pessoas[0];
    if (o.pessoa && !(Array.isArray(o.pessoas) && o.pessoas.length)) o.pessoas = [o.pessoa];
    return o;
  }
  const temCampos = (id, c) => (PSCHEMA[id] || []).every(x => { const v = c[x]; return Array.isArray(v) ? v.length > 0 : v && typeof v === 'object' ? Object.keys(v).length > 0 : !!v; });
  // qual card desenhar: "pN" direto, ou template_painel "Card N" quando existe C['pN'] e a cena tem os campos dele
  function cardDe(s) {
    if (/^p\d+$/.test(String(s.card)) && C[s.card]) return s.card;
    const m = /(\d{1,3})/.exec(String(s.template_painel || '')), pk = m ? 'p' + Number(m[1]) : null;
    if (pk && C[pk] && temCampos(pk, pCampos(s.campos))) return pk;
    return s.card;
  }
  /* ===== v11 (25/11, pedido dela): elenco de 6 na intro, tabela que volta, overlays de história, lula desenhada ===== */
  const LULA = '<svg viewBox="0 0 40 48" style="height:1.05em;width:.9em;vertical-align:-.18em;display:inline-block"><path d="M20 2C11 2 6 10 6 19c0 5 2 8 4 10h20c2-2 4-5 4-10C34 10 29 2 20 2z" fill="#F4A0A6"/><path d="M8 13 1 9l5 9zM32 13l7-4-5 9z" fill="#F4A0A6"/><g stroke="#F4A0A6" stroke-width="3.4" stroke-linecap="round" fill="none"><path d="M11 29c-2 6-6 8-6 13"/><path d="M16 29c0 7-3 10-2 16"/><path d="M24 29c0 7 3 10 2 16"/><path d="M29 29c2 6 6 8 6 13"/></g><circle cx="15" cy="20" r="2.6" fill="#2a1a1a"/><circle cx="25" cy="20" r="2.6" fill="#2a1a1a"/><circle cx="15.8" cy="19.2" r=".9" fill="#fff"/><circle cx="25.8" cy="19.2" r=".9" fill="#fff"/><path d="M17 24.5q3 2.4 6 0" stroke="#2a1a1a" stroke-width="1.6" fill="none" stroke-linecap="round"/><ellipse cx="11.5" cy="23.5" rx="2.2" ry="1.3" fill="#ec7f8a"/><ellipse cx="28.5" cy="23.5" rx="2.2" ry="1.3" fill="#ec7f8a"/></svg>';
  function lulaSvg(h) { return h.indexOf('🦑') < 0 ? h : h.replace(/🦑/g, LULA); }

  const V11CSS = `
.cpalco .v11-tag{position:absolute;z-index:12;background:rgba(18,13,10,.74);color:#F6EEDF;padding:9px 18px 11px;border-radius:10px;-webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px)}
.cpalco .v11-tag::before{content:none}
.cpalco .v11-tag.forte{background:var(--p-ac);color:#1b130d}
.cpalco .v11-polar{position:absolute;left:540px;top:930px;width:770px;z-index:20;background:#f6efe2;padding:16px 16px 0;box-shadow:14px 18px 0 #0000003d}
.cpalco .v11-polar img{width:100%;height:440px;object-fit:cover;display:block}
.cpalco .v11-polar .lg{font:700 24px/1.25 'JetBrains Mono',monospace;letter-spacing:.03em;color:#2a1e16;padding:16px 6px 18px}
.cpalco .v11-cab{position:absolute;border-radius:50%;overflow:hidden;background:#d9c8ad;box-shadow:0 0 0 3px #2a1e16}
.cpalco .v11-cab img{width:100%;height:100%;object-fit:cover;object-position:center top;filter:grayscale(1) contrast(1.05);display:block}
.cpalco .v11-cel{position:absolute;display:flex;align-items:center;justify-content:center;text-align:center}
.cpalco.pcard .p-cidade{opacity:.5}
.cpalco .v12-fade{position:absolute}
.cpalco .v12-c86 img{-webkit-mask-image:linear-gradient(to bottom,#000 50%,rgba(0,0,0,.55) 72%,transparent 92%);mask-image:linear-gradient(to bottom,#000 50%,rgba(0,0,0,.55) 72%,transparent 92%)}
.cpalco .v12-fade img{width:100%;height:100%;object-fit:contain;object-position:center bottom;display:block;filter:grayscale(1) contrast(1.06);-webkit-mask-image:linear-gradient(to bottom,#000 40%,transparent 90%);mask-image:linear-gradient(to bottom,#000 40%,transparent 90%)}
.cpalco .v12-fade.frente img{object-fit:contain;object-position:center top;-webkit-mask-image:linear-gradient(to bottom,#000 46%,transparent 80%);mask-image:linear-gradient(to bottom,#000 46%,transparent 80%)}
.cpalco .v11-ok,.cpalco .v11-x{width:60px;height:60px;border-radius:50%;display:flex;align-items:center;justify-content:center;font:800 38px/1 'Inter Tight',sans-serif;color:#f7efe0}
.cpalco .v11-ok{background:#4C6A4E}.cpalco .v11-x{background:#A8452F}
.cpalco .v11-faixa{position:absolute;left:150px;right:165px;background:#2a1e160d}
`;
  if (typeof document !== 'undefined' && !document.getElementById('v11css')) { const st = document.createElement('style'); st.id = 'v11css'; st.textContent = V11CSS; document.head.appendChild(st); }

  // overlays de história: etiquetas de papel com fita (até 3 frases curtas) e polaroide que entra e sai
  function ovl(c, tl, s) {
    let h = '';
    const ps = (c.passos || []).slice(0, 3);
    if (ps.length && c.passos_linha) {
      const F = PRUB(700, 1.08, -0.012);
      h += `<div class="ab" style="top:${c.passos_y || 0}px;z-index:12;display:flex;flex-wrap:wrap;gap:22px 18px;align-items:flex-start" data-linha>` + ps.map((p, i) => {
        const t0 = typeof p.t === 'number' ? p.t - s.start : 0.5 + 0.3 * i, a = CAPA && t0 < 1 ? 1 : ease((tl - t0) / 0.45);
        const R = texto(p.texto, { ...F, base: 38, min: 30, piso: 28, larg: 720, maxLin: 2 });
        return `<div class="v11-tag${p.forte ? ' forte' : ''}" style="position:relative;opacity:${a.toFixed(3)};transform:translateY(${((1 - a) * 22).toFixed(1)}px)"><div class="tx" style="${pcss(F, R)}">${R.html}<\/div><\/div>`; }).join('') + '<\/div>';
    } else if (ps.length) {
      let y = c.passos_y || 900; const dir = c.passos_lado === 'dir', F = PRUB(700, 1.08, -0.012);
      ps.forEach((p, i) => {
        const t0 = typeof p.t === 'number' ? p.t - s.start : 0.5 + 0.3 * i, a = CAPA && t0 < 1 ? 1 : ease((tl - t0) / 0.45);
        const R = texto(p.texto, { ...F, base: 38, min: 32, piso: 28, larg: 620, maxLin: 2 });
        const yy = typeof p.y === 'number' ? p.y : y, dd = p.lado ? p.lado === 'dir' : dir;
        h += `<div class="v11-tag${p.forte ? ' forte' : ''}" style="top:${yy}px;${dd ? 'right:165px' : 'left:' + (c.passos_x || 150) + 'px'};opacity:${a.toFixed(3)};transform:translateY(${((1 - a) * 26).toFixed(1)}px)"><div class="tx" style="${pcss(F, R)}">${R.html}<\/div><\/div>`;
        y += R.h + 20 + 10;
      });
    }
    for (const ad of [c.adesivo, ...(c.adesivos || [])]) {
      if (!ad || !ad.foto) continue;
      const t0 = ad.t - s.start, t1 = typeof ad.ate === 'number' ? ad.ate - s.start : 1e9, a = ease((tl - t0) / 0.4) * (1 - ease((tl - t1) / 0.4));
      const pos = ad.pos ? `left:${ad.pos[0]}px;top:${ad.pos[1]}px;` : '';
      const lar = ad.larg ? `width:${ad.larg}px;` : '';
      if (a > 0.01) h += `<div class="v11-polar" style="${pos}${lar}opacity:${a.toFixed(3)};transform:translate(-50%,-50%) rotate(${ad.rot ?? -3}deg) scale(${(0.92 + 0.08 * a).toFixed(3)})"><img src="${E(ad.foto)}"><div class="lg">${E(ad.legenda || '')}<\/div><\/div>`;
    }
    return h;
  }


  // Manchete: foto inteira de fundo + palavra gigante + manchete (modelo do post "DECIDIU!")
  PN.pmanchete = (c, tl, s, k) => {
    const T = { bg: '#120d0a', ink: '#F6EEDF', ac: '#F2C14E' };
    let h = `<div class="ab" style="left:0;top:0;width:1080px;height:1920px;z-index:1;overflow:hidden"><img src="${E(c.foto)}" style="width:100%;height:100%;object-fit:cover;object-position:${c.foto_pos || 'center 20%'};transform:scale(${(1.08 - 0.06 * Math.min(1, tl / 6)).toFixed(4)})"><\/div>`;
    h += `<div class="ab" style="left:0;top:0;width:1080px;height:1920px;z-index:2;background:linear-gradient(180deg,rgba(18,13,10,0) 30%,rgba(18,13,10,.55) 52%,rgba(18,13,10,.93) 68%,#120d0a 82%)"><\/div>`;
    const y = c.y || 1000, a1 = CAPA ? 1 : ease((tl - (c.t_palavra ?? 0.05)) / 0.35), a2 = CAPA ? 1 : ease((tl - (c.t_manchete ?? 0.5)) / 0.5);
    h += `<div class="ab zs" style="left:${X0}px;width:${LARG}px;top:${y}px;z-index:4;text-align:center;font-family:Rubik;font-weight:900;font-size:150px;line-height:1;letter-spacing:-0.02em;color:var(--p-ac);opacity:${a1.toFixed(3)};transform:scale(${(1.25 - 0.25 * a1).toFixed(3)})">${E(c.palavra || '')}<\/div>`;
    h += `<div class="ab zs" style="left:${X0}px;width:${LARG}px;top:${y + 175}px;z-index:4;text-align:center;font-family:Rubik;font-weight:800;font-size:58px;line-height:1.04;letter-spacing:-0.02em;color:#fff;text-transform:uppercase;text-wrap:balance;opacity:${a2.toFixed(3)};transform:translateY(${((1 - a2) * 30).toFixed(1)}px)">${E(c.manchete || '')}<\/div>`;
    if (c.credito) h += `<div class="ab zs" style="left:${X0}px;width:${LARG}px;top:${y + 175 + (c.alt_manchete || 250)}px;z-index:4;text-align:center;font-family:'JetBrains Mono';font-size:24px;letter-spacing:.06em;color:var(--p-ac);opacity:${a2.toFixed(3)}">${E(c.credito)}<\/div>`;
    return { bg: T.bg, fg: T.ink, escuro: 1, vars: pVars(T), html: h, fim: y + 500, falta: false };
  };

  // Carrossel de retratos: a da vez vai pro meio, maior e colorida; as outras menores, P&B, dos lados
  PN.pcarrossel = (c, tl, s, k) => {
    const T = pTema(s, { bg: '#2c1f17', ink: '#F6EEDF', ac: '#E0A85C' }, 'escuro');
    const M = pMast(c, tl, { ls: 0.045, pt: 17 }); let h = M.html;
    const Ti = pTit(c, Math.max(M.bot + 28, 300), k, tl, { fonte: PSERIF, base: 84 }); h += Ti.html;
    const its = c.itens || [], n = its.length, ts = its.map(p => (p.t ?? 0) - s.start);
    let f = 0; ts.forEach((t, i) => { if (tl >= t) f = i; });
    const fPrev = Math.max(0, f - 1), pr = f === 0 ? 1 : ease((tl - ts[f]) / 0.55), fx = fPrev + (f - fPrev) * pr;
    const fvB = c.faixa_video && c.faixa_video.embaixo;
    const cx = 540, top = Math.max(Ti.bot + (fvB ? 40 : 60) + (c.aviso ? 72 : 0), fvB ? 560 : 640), W = fvB ? (c.faixa_video.alto ? 250 : 330) : 400, H = fvB ? (c.faixa_video.alto ? 310 : 430) : 560;
    its.forEach((p, i) => {
      const a = CAPA ? 1 : ease((tl - (ts[0] - 0.4) - i * 0.12) / 0.5);
      const d = i - fx, ad = Math.min(1, Math.abs(d)), sc = 1 - 0.42 * ad, x = cx + d * 235, op = (1 - 0.45 * ad) * a * Math.max(0, Math.min(1, 1.8 - Math.abs(d))), gs = ad;
      h += `<div class="ab" style="left:${(x - W / 2).toFixed(1)}px;top:${top}px;width:${W}px;height:${H}px;z-index:${10 - Math.round(Math.abs(d) * 2)};opacity:${op.toFixed(3)};transform:scale(${sc.toFixed(3)}) translateY(${(ad * 60).toFixed(1)}px);transform-origin:center bottom;filter:grayscale(${gs.toFixed(2)});-webkit-mask-image:linear-gradient(#000 70%,transparent 100%);mask-image:linear-gradient(#000 70%,transparent 100%)"><img src="${E(p.foto || SILHUETA)}" style="width:100%;height:100%;object-fit:cover;object-position:center top;border-radius:18px"><\/div>`;
    });
    if (c.aviso) { const ta = (c.aviso.t ?? s.start) - s.start, a = CAPA ? 1 : ease((tl - ta) / 0.5);
      h += `<div class="ab" style="top:${Ti.bot + 18}px;left:${X0}px;width:${LARG}px;text-align:left;z-index:15;opacity:${a.toFixed(3)};transform:translateY(${((1 - a) * 14).toFixed(1)}px)"><span style="display:inline-block;border:3px dashed var(--p-ac);background:color-mix(in srgb,var(--p-ac) 16%,transparent);color:var(--p-ink,#F6EEDF);font:700 25px/1.2 Rubik,sans-serif;padding:9px 16px;border-radius:14px">${E(c.aviso.texto)}<\/span><\/div>`;
      const a2 = CAPA ? 1 : ease((tl - (ts[0] - 0.4)) / 0.5); h += `<div class="ab" data-deco style="left:${cx - W / 2 - 14}px;top:${top - 14}px;width:${W + 28}px;height:${H + 6}px;right:auto;border:3px dashed var(--p-ac);border-radius:22px;z-index:9;opacity:${(a2 * 0.9).toFixed(3)}"><\/div>`; }
    const fv = c.faixa_video;
    if (fv && fv.frames && fv.frames.length) {
      const t0 = fv.t0 - s.start, t1 = fv.t1 - s.start, av = CAPA ? 0 : ease((tl - t0) / 0.3) * (1 - ease((tl - t1) / 0.4));
      if (av > 0.01) { const fi = Math.max(0, Math.min(fv.frames.length - 1, Math.floor((tl - t0) * (fv.fps || 12))));
        const fi2 = fv.embaixo ? Math.floor((tl - t0) * (fv.fps || 12)) % fv.frames.length : null;
        h += `<div class="ab" style="left:${X0 - 40}px;top:${fv.embaixo ? top + H + 175 : Math.max(Ti.bot + 50, 620)}px;width:${LARG + 80}px;height:${fv.embaixo ? (fv.alto ? Math.min(400, LIM - 4 - (top + H + 175)) : 230) : 520}px;z-index:20;opacity:${av.toFixed(3)};border-radius:16px;overflow:hidden;box-shadow:0 20px 50px rgba(0,0,0,.45);transform:rotate(-1.2deg)"><img src="${E(fv.frames[fi2 ?? fi])}" style="width:100%;height:100%;object-fit:cover"><div style="position:absolute;left:0;right:0;bottom:0;padding:14px 62px;background:linear-gradient(transparent,rgba(0,0,0,.75));font:700 26px Rubik;color:#F6EEDF">${E(fv.legenda || '')}<\/div><\/div>`; }
    }
    const p = its[f] || {}, a = CAPA ? 1 : ease((tl - ts[f] - 0.15) / 0.4);
    const NF = PRUB(800, 1.02, -0.02), N = texto(p.nome || '', { ...NF, base: 52, min: 40, piso: 34, larg: LARG, maxLin: 1 });
    const CF = PRUB(600, 1.15, 0), C2 = texto(p.fato || '', { ...CF, base: 34, min: 28, piso: 26, larg: LARG, maxLin: 2 });
    const ny = top + H + (fvB ? 10 : 24);
    h += `<div class="ab zs" style="top:${ny}px;left:${X0}px;width:${LARG}px;text-align:center;z-index:12;opacity:${a.toFixed(3)}"><div class="tx" style="${pcss(NF, N)}">${N.html}<\/div><div class="tx" style="${pcss(CF, C2)};color:var(--p-ac);margin-top:8px">${C2.html}<\/div>${p.chip ? `<div style="margin-top:12px"><span class="v11-tag" style="position:static;display:inline-block;font:700 22px Rubik">${E(p.chip)}<\/span><\/div>` : ''}<\/div>`;
    return { bg: T.bg, fg: T.ink, escuro: 1, vars: pVars(T), html: h + `<div class="p-grao" data-deco style="opacity:.25"><\/div>`, fim: ny + N.h + C2.h + 60, falta: false };
  };

  // Elenco de 6 (intro): os dois nomes centrais grandes, as quatro cotadas embaixo
  PN.pel6 = (c, tl, s, k) => {
    const T = pTema(s, { bg: '#7d3526', ink: '#fff0dc', ac: '#f2c47c' }, 'escuro');
    const M = pMast(c, tl, { ls: 0.045, pt: 17 }); let h = M.html, y = Math.max(M.bot + 34, 350);
    const Ti = pTit(c, y, k, tl, { fonte: PSERIF, base: 96 }); h += Ti.html; y = Ti.bot + Math.round(30 * k);
    const ML = { ...PMONO, ls: 0.08, up: 1 };
    const lab = (txt, yy, t0) => { const R = texto(txt, { ...ML, base: 22, min: 20, piso: 18, larg: LARG, maxLin: 1 }); return { h: R.h, html: `<div class="ab tx pa" style="top:${yy}px;${pcss(ML, R)};border-top:1px solid currentColor;padding-top:8px;${ent(tl, t0)}">${R.html}<\/div>` }; };
    const tAt = (x, d) => typeof x.t === 'number' ? x.t - s.start : d;
    const eles = c.eles || [], elas = c.elas || [];
    let L = lab(c.rot_eles || 'Eles', y, 0.2); h += L.html; y += L.h + 18;
    const cw = Math.floor((LARG - 30) / 2), bh = Math.round(300 * k);
    const yMen = y; const Ns = eles.map(p => pNome(p, cw, k, { borda: false })), nh = Math.max(0, ...Ns.map(n => n.h));
    eles.forEach((p, i) => { const x = X0 + i * (cw + 30), t0 = tAt(p, 0.3 + 0.3 * i);
      h += `<div class="p-recorte" style="left:${x}px;top:${y}px;width:${cw}px;height:${bh}px;${ent(tl, t0, 0.5, 30)}"><img src="${E(p.foto || SILHUETA)}"><\/div>`;
      h += `<div class="ab zs" style="top:${y + bh + 12}px;left:${x}px;right:auto;width:${cw}px;${ent(tl, t0 + 0.2)}">${Ns[i].html}<\/div>`; });
    y += bh + 12 + nh + Math.round(26 * k);
    L = lab(c.rot_elas || 'Elas', y, tAt(elas[0] || {}, 1.5)); h += L.html; y += L.h + 16;
    const n = Math.max(1, elas.length), g = 18, ew = Math.floor((LARG - g * (n - 1)) / n), eh = Math.round(185 * k);
    const NF = PRUB(700, 1.05, -0.02), CF = { ...PMONO, ls: 0.02, up: 1 };
    elas.forEach((p, i) => { const x = X0 + i * (ew + g), t0 = tAt(p, 1.5 + 0.2 * i);
      const N = texto(p.nome || '', { ...NF, base: 27 * k, min: 22, piso: 20, larg: ew, maxLin: 2 }), C2 = texto(p.chip || '', { ...CF, base: 20, min: 18, piso: 17, larg: ew - 22, maxLin: 2 });
      h += `<div class="p-recorte" style="left:${x}px;top:${y}px;width:${ew}px;height:${eh}px;${ent(tl, t0, 0.5, 30)}"><img src="${E(p.foto || SILHUETA)}"><\/div>`;
      h += `<div class="ab zs" style="top:${y + eh + 10}px;left:${x}px;right:auto;width:${ew}px;${ent(tl, t0 + 0.15)}"><div class="tx" style="${pcss(NF, N)}">${N.html}<\/div>` +
        `<div style="display:flex;gap:8px;align-items:flex-start;margin-top:8px"><i class="p-pontochip" style="--c:#0B0B0C;flex:none;margin-top:4px"><\/i><div class="tx" style="${pcss(CF, C2)};opacity:.85">${C2.html}<\/div><\/div><\/div>`; });
    const fim = y + eh + 10 + 60 + 50;
    if (c.tag) { const t0 = c.tag.t - s.start, a = ease((tl - t0) / 0.45), F = PRUB(700, 1.08, -0.012), R = texto(c.tag.texto, { ...F, base: 34, min: 28, piso: 26, larg: 380, maxLin: 2 });
      h += `<div class="v11-tag forte" style="top:${yMen + bh - 62}px;right:160px;opacity:${a.toFixed(3)};transform:translateY(${((1 - a) * 20).toFixed(1)}px)"><div class="tx" style="${pcss(F, R)}">${R.html}<\/div><\/div>`; }
    return { bg: T.bg, fg: T.ink, escuro: 1, vars: pVars(T), html: h + REGUA + GRAO, fim, falta: false };
  };

  // Tabela comparativa: itens na vertical, cabecinhas no topo; célula = número, ✓, ✗ ou sigla (sem frase)
  PN.ptab = (c, tl, s, k) => {
    const T = { bg: '#EBE0CC', ink: '#2A1E16', ac: '#A8452F' };
    const M = pMast(c, tl, { ls: 0.045, pt: 17 }); let h = M.html, y = Math.max(M.bot + 34, 350);
    const Ti = pTit(c, y, k, tl, { fonte: PSERIF, base: 104 }); h += Ti.html; y = Ti.bot + Math.round(40 * k);
    const cols = c.cols || [], n = Math.max(1, cols.length), LW = 214, cw = Math.floor((LARG - LW) / n), xc = i => X0 + LW + i * cw;
    const ML = { ...PMONO, ls: 0.06, up: 1 };
    if (c.grupos && n >= 3) {
      [['Eles', 0, 2], ['Elas', 2, n]].forEach(([tx, a, b]) => { const R = texto(tx, { ...ML, base: 20, min: 18, piso: 18, larg: 200, maxLin: 1 });
        h += `<div class="ab tx" style="top:${y}px;left:${xc(a) + 6}px;right:auto;width:${(b - a) * cw - 12}px;border-bottom:2px solid currentColor;padding-bottom:6px;text-align:center;${pcss(ML, R)};${ent(tl, 0.1)}">${R.html}<\/div>`; });
      y += 44;
    }
    const cab = Math.min(cw - 12, 100);
    cols.forEach((cc, i) => { const x = xc(i) + (cw - cab) / 2;
      h += `<div class="v11-cab" style="left:${x}px;top:${y}px;width:${cab}px;height:${cab}px;${ent(tl, 0.15 + 0.06 * i, 0.4, 20)}"><img src="${E(cc.foto || SILHUETA)}"><\/div>`;
      const R = texto(cc.curto || '', { ...ML, base: 17, min: 15, piso: 14, larg: cw, maxLin: 1 });
      h += `<div class="ab tx" style="top:${y + cab + 10}px;left:${xc(i)}px;right:auto;width:${cw}px;text-align:center;${pcss(ML, R)};${ent(tl, 0.2 + 0.06 * i)}">${R.html}<\/div>`; });
    y += cab + 44;
    const rows = c.linhas || [], rh = Math.round(150 * k), LF = PRUB(700, 1.05, -0.02);
    (c.foco || []).forEach(i => { h += `<div class="ab" data-deco style="top:${y - cab - 50}px;left:${xc(i) + 4}px;right:auto;width:${cw - 8}px;height:${cab + 50 + rows.length * rh + 8}px;border:3px solid ${T.ac};border-radius:14px;background:${T.ac}14;${ent(tl, 0.1)}"><\/div>`; });
    rows.forEach((r, ri) => {
      const top = y + ri * rh;
      if (ri % 2 === 0) h += `<div class="v11-faixa" data-deco style="top:${top}px;height:${rh}px"><\/div>`;
      h += `<div class="ab" data-deco style="top:${top}px;border-top:1px solid #2a1e1655"><\/div>`;
      const R = texto(r.rotulo || '', { ...LF, base: 31 * k, min: 24, piso: 22, larg: LW - 18, maxLin: 2 });
      h += `<div class="ab tx" style="top:${top + (rh - R.h) / 2}px;${pcss(LF, R)};${ent(tl, 0.3 + 0.1 * ri)}">${R.html}<\/div>`;
      const vals = r.v || [], mx = r.tipo === 'num' ? Math.max(...vals.map(Number)) : null;
      vals.forEach((v, i) => {
        const ct = c.col_t ? c.col_t[i] : null, tt = typeof ct === 'number' ? ct : (i < 2 && typeof r.t_eles === 'number' ? r.t_eles : r.t);
        const a = typeof tt === 'number' ? (CAPA ? 1 : ease((tl - (tt - s.start)) / 0.4)) : 0;
        let inner;
        if (r.tipo === 'num') { const top1 = Number(v) === mx && mx > 0;
          inner = `<span style="font:800 ${top1 ? 58 : 48}px/1 'Inter Tight',sans-serif;letter-spacing:-.03em;color:${top1 ? T.ac : T.ink}">${E(v)}<\/span>`; }
        else if (v === 'ok') inner = '<span class="v11-ok">✓<\/span>';
        else if (v === 'x') inner = '<span class="v11-x">✕<\/span>';
        else inner = `<span style="font:700 ${String(v).length > 4 ? 18 : 22}px/1.1 'JetBrains Mono',monospace;letter-spacing:.02em">${E(v)}<\/span>`;
        const q = `<span style="font:700 34px/1 'Inter Tight',sans-serif;opacity:.22">?<\/span>`;
        h += `<div class="v11-cel" style="left:${xc(i)}px;top:${top}px;width:${cw}px;height:${rh}px">` +
          (a < 0.3 ? `<div style="position:absolute;opacity:${(1 - a / 0.3).toFixed(3)}">${q}<\/div>` : '') +
          (a > 0.01 ? `<div style="opacity:${a.toFixed(3)};transform:scale(${(0.7 + 0.3 * a).toFixed(3)})">${inner}<\/div>` : '') + '<\/div>';
      });
    });
    y += rows.length * rh; h += `<div class="ab" data-deco style="top:${y}px;border-top:2px solid #2a1e16"><\/div>`; y += 30;
    if (c.nota) { const t0 = typeof c.t_nota === 'number' ? c.t_nota - s.start : 0.8, a = CAPA ? 1 : ease((tl - t0) / 0.45), F = PRUB(700, 1.08, -0.012), R = texto(c.nota, { ...F, base: 34, min: 28, piso: 26, larg: 620, maxLin: 2 });
      h += `<div class="v11-tag forte" style="top:${y + 14}px;left:150px;opacity:${a.toFixed(3)};--p-ac:#E3B867"><div class="tx" style="${pcss(F, R)}">${R.html}<\/div><\/div>`; y += R.h + 60; }
    return { bg: T.bg, fg: T.ink, escuro: 0, vars: pVars(T), html: h + GRAO, fim: y, falta: false };
  };

  // Card 150 de verdade (só cabeças em camadas), com as 6 pessoas do vídeo: 4 atrás, os 2 nomes centrais na frente
  PN.pheads = (c, tl, s, k) => {
    const T = { bg: '#F2EADB', ink: '#1E1712', ac: '#A8452F' };
    const M = pMast(c, tl, { fs: 26, ls: 0.14, pt: 16, borda: 'border-top-width:4px;' }); let h = M.html;
    const Ti = pTit(c, Math.max(M.bot + 28, 300), k, tl, { fonte: { f: 'Rubik', p: 800, lh: 0.98, ls: -0.045 }, base: 100 }); h += Ti.html;
    if (c.fundo) h += `<div class="ab" data-deco style="inset:0;left:0;right:0;top:0;bottom:0;z-index:0;opacity:${CAPA ? 0.24 : (0.24 * ease(tl / 0.6)).toFixed(3)};-webkit-mask-image:linear-gradient(180deg,transparent 10%,#000 30%,#000 78%,transparent 96%);mask-image:linear-gradient(180deg,transparent 10%,#000 30%,#000 78%,transparent 96%)"><img src="${E(c.fundo)}" style="width:100%;height:100%;object-fit:cover;object-position:center 50%;filter:grayscale(1) sepia(.6) hue-rotate(-12deg) blur(5px) contrast(.8);display:block"><\/div>`;
    const tA = (p, d) => typeof p.t === 'number' ? p.t - s.start : d, nomes = c.nomes !== false;
    if (c.passos_linha && !c.passos_y) c.passos_y = Ti.bot + 30;
    const tras = c.tras || [], frente = c.frente || [];
    const NF = PRUB(700, 1.04, -0.02), CF = { ...PMONO, ls: 0.02, up: 1 };
    // fileira de trás: 4 cabeças médias, nítidas (aqui ninguém perdeu), nome em cima
    const n = Math.max(1, tras.length), g = c.cab_gap ?? 14, tw = c.cab_larg || Math.floor((LARG + 60 - g * (n - 1)) / n), x0 = c.cab_larg ? Math.round(540 - (n * tw + (n - 1) * g) / 2) : X0 - 30;
    let yN = Math.max(Ti.bot + 40, 760) + (c.folga_topo || 0);
    tras.forEach((p, i) => { const x = x0 + i * (tw + g), t0 = tA(p, 0.2 + 0.15 * i), a = CAPA ? 1 : ease((tl - t0) / 0.6);
      if (nomes) { const lw = c.cab_larg ? tw - 6 : Math.min(x + tw - 3, X1) - Math.max(x + 3, X0), N = texto(p.nome || '', { ...NF, base: c.nome_base || 25, min: 22, piso: 20, larg: lw, maxLin: 2 }), C2 = texto(p.chip || '', { ...CF, base: c.chip_base || 19, min: 18, piso: 17, larg: lw, maxLin: 2 });
        const nl = c.cab_larg ? x + 3 : Math.max(x + 3, X0), nr = c.cab_larg ? x + tw - 3 : Math.min(x + tw - 3, X1);
        h += `<div class="ab zs" style="top:${yN - N.h - C2.h - (c.foco_fala ? 30 : 6)}px;left:${nl}px;right:auto;width:${nr - nl}px;${ent(tl, t0 + 0.2)}"><div class="tx" style="${pcss(NF, N)}">${N.html}<\/div><div class="tx" style="${pcss(CF, C2)};color:var(--p-ac);margin-top:4px">${C2.html}<\/div><\/div>`; }
      const ie = c.img_esc || 1, iw = Math.round(tw * ie); let fk = 0; if (c.foco_fala && !CAPA && typeof p.t === 'number') { const nx = tras[i + 1], ti = p.t - s.start, tn = nx && typeof nx.t === 'number' ? nx.t - s.start : 1e9; fk = ease((tl - ti) / 0.35) * (1 - ease((tl - tn) / 0.35)); }
      if (fk > 0.01) h += `<div class="ab" data-deco style="left:${Math.round(x + tw / 2 - iw * 0.75)}px;top:${yN - 20}px;width:${Math.round(iw * 1.5)}px;height:${Math.round(iw * 1.3)}px;right:auto;z-index:2;opacity:${fk.toFixed(3)};background:radial-gradient(ellipse at 50% 55%,color-mix(in srgb,var(--p-ac) 26%,transparent),transparent 68%)"><\/div>`;
      h += `<div class="v12-fade" style="left:${Math.round(x - (iw - tw) / 2)}px;top:${yN + 8}px;width:${iw}px;height:${Math.round(iw * 1.05)}px;z-index:${fk > 0.5 ? 5 : 3};opacity:${a.toFixed(3)};transform-origin:50% 100%;transform:translateY(${((1 - a) * 40).toFixed(1)}px) scale(${(1 + 0.12 * fk).toFixed(3)});${fk > 0.01 ? `filter:drop-shadow(0 ${(14 * fk).toFixed(1)}px ${(18 * fk).toFixed(1)}px rgba(40,25,15,${(0.35 * fk).toFixed(2)}))` : ''}"><img src="${E(p.foto || SILHUETA)}" style="object-position:center top"><\/div>`; });
    tras.forEach((p, i) => { if (!p.destaque) return; const x = x0 + i * (tw + g), t0 = tA(p, 0), a = CAPA ? 1 : ease((tl - t0) / 0.6), fy = yN - (c.foco_fala ? 150 : 124), fh = (c.foco_fala ? 150 : 124) + Math.round(tw * (c.img_esc || 1) * 1.05) + 6, fw2 = Math.round(tw * Math.min(c.img_esc || 1, 1.3)), fx2 = Math.round(x - (fw2 - tw) / 2);
      h += `<div class="ab" data-deco style="left:${fx2 - 8}px;top:${fy}px;width:${fw2 + 16}px;height:${fh}px;right:auto;border:3px dashed var(--p-ac);border-radius:18px;background:color-mix(in srgb,var(--p-ac) 9%,transparent);z-index:2;opacity:${a.toFixed(3)}"><\/div>`;
      if (p.nota) h += `<div class="ab" style="left:${Math.min(x - 60, X1 - tw - 120)}px;top:${fy - 62}px;width:${tw + 120}px;right:auto;text-align:center;z-index:8;opacity:${a.toFixed(3)}"><span style="display:inline-block;background:var(--p-ac);color:#fff;font:700 21px/1.15 Rubik,sans-serif;padding:8px 12px;border-radius:10px">${E(p.nota)}<\/span><\/div>`; });
    // número grande embaixo da fileira (27/11): troca conforme a fala
    if (c.numeros && c.numeros.length) { const yB = yN + 8 + Math.round(tw * (c.img_esc || 1) * 1.05) + 30; let cur = -1;
      c.numeros.forEach((q, i) => { if (CAPA ? i === c.numeros.length - 1 : tl >= q.t - s.start) cur = i; });
      c.numeros.forEach((q, i) => { const t0 = q.t - s.start, nx = c.numeros[i + 1], fimq = nx ? nx.t - s.start : 1e9;
        const a = CAPA ? (i === cur ? 1 : 0) : Math.min(ease((tl - t0) / 0.45), 1 - ease((tl - fimq) / 0.3));
        if (a <= 0.001) return;
        const NB = { f: 'Rubik', p: 800, lh: 0.9, ls: -0.04 }, R = texto(q.n, { ...NB, base: 190, min: 120, piso: 110, larg: 520, maxLin: 1 }), FT = PRUB(700, 1.08, -0.015), D = texto(q.txt, { ...FT, base: 38, min: 30, piso: 28, larg: 300, maxLin: 3 }), W = texto(q.quem || '', { ...FT, base: 30, min: 24, piso: 22, larg: 380, maxLin: 2 });
        h += `<div class="ab" style="top:${yB}px;left:${X0}px;right:auto;width:${LARG}px;display:flex;align-items:center;gap:30px;z-index:5;opacity:${a.toFixed(3)};transform:translateY(${((1 - a) * 24).toFixed(1)}px)"><div class="tx" style="${pcss(NB, R)};color:var(--p-ac);flex:none">${R.html}<\/div><div><div class="tx" style="${pcss(FT, W)};color:var(--p-ac);margin-bottom:6px">${W.html}<\/div><div class="tx" style="${pcss(FT, D)}">${D.html}<\/div>${q.extra ? `<div style="margin-top:10px;display:inline-block;border:2px dashed var(--p-ac);border-radius:10px;padding:6px 10px;font:700 22px/1.2 Rubik,sans-serif;color:var(--p-ac)">${E(q.extra)}<\/div>` : ''}<\/div><\/div>`; }); }
    // fileira da frente: 2 cabeças grandes por cima da de trás
    const fw = frente.length === 1 ? 460 : 400, gap = 20, fx = frente.length === 1 ? [X0 + Math.round((LARG - 460) / 2)] : [X0 - 10, X0 + LARG - fw + 10], fy = yN + 8 + Math.round(tw * 0.55) + (c.desce_frente || 0);
    const Ns = frente.map(p => pNome(p, fw - 20, k, { borda: false })), nh = Math.max(0, ...Ns.map(q => q.h));
    const fh = Math.min(Math.round(fw * 1.2), LIM - 8 - nh - 14 - fy + 95);
    frente.forEach((p, i) => { const t0 = tA(p, 0.8 + 0.25 * i), a = CAPA ? 1 : ease((tl - t0) / 0.6);
      h += `<div class="v12-fade frente" style="left:${fx[i]}px;top:${fy}px;width:${fw}px;height:${fh}px;z-index:6;opacity:${a.toFixed(3)};transform:translateY(${((1 - a) * 60).toFixed(1)}px)"><img src="${E(p.foto)}" style="object-position:center top"><\/div>`;
      if (nomes) h += `<div class="ab zs" style="top:${fy + fh - 81}px;left:${fx[i] + 10}px;right:auto;width:${fw - 20}px;z-index:7;${ent(tl, t0 + 0.3)}">${Ns[i].html}<\/div>`; });
    return { bg: T.bg, fg: T.ink, escuro: 0, vars: pVars(T), html: h + `<div class="p-grao" data-deco style="opacity:.28"><\/div>`, fim: fy + fh - 81 + (nomes ? nh : 0), falta: false };
  };


  // 27/11 noite 3 (ela escolheu a opção D da página de opções): card VC13 v1 "Uma pessoa em foco" adaptado ao motor.
  // Governo atual nítido em P&B na frente, as 4 cotadas desfocadas e tingidas atrás, prédios borrados ao fundo.
  // Card 2 · "MULHERES" vazado (inspirado no card 65 do acervo, Vibe cool · palavra-chave vazada; 28/11)
  // fotos aparecem, a tela escurece e a palavra entra gigante com as 4 cotadas por dentro das letras
  PN.pvaz = (c, tl, s, k) => {
    const CL = !!c.claro, T = CL ? { bg: '#F4C982', ink: '#0D0E0C', ac: '#E0307F' } : { bg: '#141416', ink: '#F4C982', ac: '#FF53AB' };
    const fotos = c.fotos || [], n = fotos.length || 1;
    let h = '';
    // fase 1: colagem P&B das 4 (vira a textura de fundo quando a tela escurece)
    const aF = CAPA ? 1 : ease(tl / 0.5), esc = 1;
    fotos.forEach((f, i) => { const w = Math.round(1180 / n), x = -50 + i * (w - 6), ai = CAPA ? 1 : ease((tl - 0.08 * i) / 0.45);
      h += `<div class="ab" data-deco style="left:${x}px;top:600px;width:${w + 40}px;height:760px;right:auto;z-index:1;opacity:${(ai * (1 - 0.82 * esc)).toFixed(3)};transform:translateY(${((1 - ai) * 40).toFixed(1)}px) scale(${(1 + 0.04 * esc).toFixed(3)});filter:grayscale(1) contrast(1.05) blur(${(esc * 6).toFixed(1)}px)"><img src="${E(f)}" style="width:100%;height:100%;object-fit:contain;object-position:center bottom;display:block"><\/div>`; });
    // véu escuro + grão (textura)
    h += `<div class="ab" data-deco style="inset:0;left:0;right:0;top:0;bottom:0;z-index:2;background:${T.bg};opacity:${(0.86 * esc).toFixed(3)}"><\/div>`;
    const M = pMast(c, tl, { ls: 0.045, pt: 17, borda: `border-top-color:${T.ink};` }); h += M.html;
    const Ti = pTit(c, Math.max(M.bot + 26, 318), k, tl, { fonte: { f: 'Rubik', p: 800, lh: 0.94, ls: -0.04 }, base: c.tit_px || 124, extra: `z-index:9;color:${T.ink};` }); h += Ti.html;
    // fase 2: a palavra gigante, esticada na vertical, com as fotos dentro das letras
    const W = 800, fs = c.pal_px || 190, sy = c.estica || 2.3, H = Math.round(fs * 0.9 * sy) + 20, wy = Math.max(Ti.bot + 60, 560);
    const t0 = 0.12, aw = CAPA ? 1 : ease((tl - t0) / 0.5), cai = CAPA ? 0 : (1 - aw) * -70, sc = CAPA ? 1 : 1 + 0.12 * (1 - aw);
    const id = 'vz' + Math.round(s.start * 100), cw = W / n, zoom = CAPA ? 1 : 1 + 0.05 * Math.min(1, Math.max(0, tl - t0) / 4);
    let imgs = `<rect x="0" y="0" width="${W}" height="${H}" fill="${CL ? '#0D0E0C' : '#F4C982'}"/>`;
    fotos.forEach((f, i) => { const iw = cw * 1.25 * zoom, ih = H * 1.05 * zoom, ix = i * cw + cw / 2 - iw / 2, iy = -H * 0.04;
      imgs += `<image href="${E(f)}" x="${ix.toFixed(1)}" y="${iy.toFixed(1)}" width="${iw.toFixed(1)}" height="${ih.toFixed(1)}" preserveAspectRatio="xMidYMin slice" style="filter:grayscale(1) contrast(1.1)"/>`; });
    const txt = `<text x="${W / 2}" y="${(fs * 0.9).toFixed(1)}" text-anchor="middle" textLength="${W}" lengthAdjust="spacingAndGlyphs" transform="scale(1 ${sy})" style="font-family:Rubik,sans-serif;font-weight:900;font-size:${fs}px;letter-spacing:-.01em">${E(c.palavra || 'MULHERES')}<\/text>`;
    h += `<div class="ab" style="left:${540 - W / 2}px;top:${wy}px;width:${W}px;height:${H}px;right:auto;z-index:6;opacity:${aw.toFixed(3)};transform:translateY(${cai.toFixed(1)}px) scale(${sc.toFixed(3)});transform-origin:center center;">` +
      `<svg width="${W}" height="${H}" viewBox="0 0 ${W} ${H}" style="display:block;overflow:visible"><defs><clipPath id="${id}">${txt}<\/clipPath><filter id="${id}f" x="-20%" y="-20%" width="140%" height="140%"><feGaussianBlur stdDeviation="9"/><\/filter><\/defs>` +
      `<g filter="url(#${id}f)" fill="#000" stroke="#000" stroke-width="16" opacity=".75">${txt}<\/g><g clip-path="url(#${id})">${imgs}<\/g><\/svg><\/div>`;
    // fase 3: nomes embaixo, cada um debaixo do seu pedaço da palavra
    const NF = PRUB(700, 1.05, -0.015), CF = { ...PMONO, ls: 0.02, up: 1 }, ny = wy + H + 30;
    let nh = 0;
    (c.nomes_lista || []).forEach((p, i) => { const x = 540 - W / 2 + i * cw, ti = (p.t ?? 0) - s.start;
      const N = texto(p.nome || '', { ...NF, base: c.nome_px || 32, min: 24, piso: 22, larg: cw - 10, maxLin: 2 }), C2 = texto(p.chip || '', { ...CF, base: 20, min: 17, piso: 16, larg: cw - 10, maxLin: 2 });
      nh = Math.max(nh, N.h + C2.h + 6);
      h += `<div class="ab zs" style="top:${ny}px;left:${Math.round(x + 5)}px;right:auto;width:${Math.round(cw - 10)}px;z-index:9;text-align:center;${ent(tl, ti, 0.4, 18)}"><div class="tx" style="${pcss(NF, N)};color:${T.ink}">${N.html}<\/div><div class="tx" style="${pcss(CF, C2)};color:${T.ac};margin-top:6px">${C2.html}<\/div><\/div>`; });
    return { bg: T.bg, fg: T.ink, escuro: CL ? 0 : 1, vars: pVars(T), html: h + `<div class="p-grao" data-deco style="opacity:.13;z-index:30"><\/div>`, fim: ny + nh, falta: false };
  };

  PN.pvc13 = (c, tl, s, k) => {
    const T = { bg: '#F4C982', ink: '#0D0E0C', ac: '#E0307F' };
    const M = pMast(c, tl, { ls: 0.045, pt: 17 }); let h = M.html;
    const F1 = { ...PSERIF, lh: 0.92, ls: -0.03 }, y0 = Math.max(M.bot + 26, 318);
        const f1 = c.t1_px || 128, f2 = c.t2_px || 100, tst = `font-family:'DM Serif Display',Georgia,serif;font-weight:400;letter-spacing:-.03em;line-height:.92;white-space:nowrap;`;
    h += `<div class="ab zs" style="top:${y0}px;z-index:9;${tst}font-size:${f1}px;${ent(tl, 0.1, 0.5, 30)}">${E(c.linha1 || '')}<\/div>`;
    h += `<div class="ab zs" style="top:${y0 + Math.round(f1 * 0.95)}px;z-index:9;${tst}font-size:${f2}px;color:#FF53AB;${ent(tl, 0.3, 0.5, 30)}">${E(c.linha2 || '')}<\/div>`;
    const a0 = CAPA ? 1 : ease(tl / 0.8);
    if (c.fundo) h += `<div class="ab" data-deco style="inset:0;left:0;right:0;top:0;bottom:0;z-index:0;opacity:${(0.25 * a0).toFixed(3)};-webkit-mask-image:linear-gradient(180deg,transparent 10%,#000 30%,#000 78%,transparent 96%);mask-image:linear-gradient(180deg,transparent 10%,#000 30%,#000 78%,transparent 96%)"><img src="${E(c.fundo)}" style="width:100%;height:100%;object-fit:cover;object-position:center 53%;filter:grayscale(1) sepia(.6) hue-rotate(-12deg) blur(5px) contrast(.8);display:block"><\/div>`;
    // atrás: 4 cotadas desfocadas, rostos em eixos diferentes do rosto da frente
    const AT = [[-40, 720, 340, 520, .75], [150, 870, 310, 440, .7], [630, 870, 310, 440, .7], [805, 880, 290, 410, .7]];
    (c.atras || []).slice(0, 4).forEach((p, i) => { const [x, y, w, hh, op] = AT[i], a = CAPA ? 1 : ease((tl - 0.35 - 0.12 * i) / 0.6);
      h += `<div class="ab" style="left:${x}px;top:${y}px;width:${w}px;height:${hh}px;right:auto;z-index:2;opacity:${(op * a).toFixed(3)};-webkit-mask-image:linear-gradient(180deg,#000 55%,transparent 97%);mask-image:linear-gradient(180deg,#000 55%,transparent 97%);transform:translateY(${((1 - a) * 30).toFixed(1)}px)"><img src="${E(p)}" style="width:100%;height:100%;object-fit:contain;object-position:center bottom;display:block;filter:grayscale(1) sepia(.8) hue-rotate(-30deg) saturate(1.6) contrast(.82) blur(8px)"><\/div>`; });
    // brilho rosa + anel fino atrás da cabeça (27/11: ela pediu o rosinha um pouco mais forte)
    const ar = CAPA ? 1 : ease((tl - 0.25) / 0.7), gy = c.anel_y || 600;
    h += `<div class="ab" data-deco style="left:240px;top:${gy}px;width:600px;height:600px;right:auto;z-index:3;border-radius:50%;border:1px solid #0D0E0C4d;background:radial-gradient(circle,#FF53AB66 0%,#FF53AB33 38%,transparent 70%);opacity:${ar.toFixed(3)};transform:scale(${(0.9 + 0.1 * ar).toFixed(3)})"><\/div>`;
    h += `<div class="ab" data-deco style="left:128px;top:1262px;width:824px;height:62px;right:auto;z-index:3;border-radius:50%;background:#0b13155c;filter:blur(24px)"><\/div>`;
    // na frente: governo atual, meio corpo, nítido em P&B; zoom lento pra capa não ficar parada
    const al = CAPA ? 1 : ease((tl - 0.15) / 0.7), z = CAPA ? 1 : 1 + 0.035 * Math.min(1, Math.max(0, tl - 0.9) / 8);
    h += `<div class="ab" style="left:250px;top:${c.frente_y || 560}px;width:580px;height:${c.frente_h || 780}px;right:auto;z-index:4;opacity:${al.toFixed(3)};transform:translateY(${((1 - al) * 50).toFixed(1)}px) scale(${z.toFixed(4)});transform-origin:center bottom;filter:drop-shadow(5px 12px 12px #0d0e1053);-webkit-mask-image:linear-gradient(180deg,#000 1%,#000 72%,#000a 86%,transparent 100%);mask-image:linear-gradient(180deg,#000 1%,#000 72%,#000a 86%,transparent 100%)"><img src="${E(c.frente)}" style="width:100%;height:100%;object-fit:contain;object-position:center bottom;display:block;filter:grayscale(1) contrast(1.06)"><\/div>`;
    // quem: governo atual + lula desenhada; à direita os passos entram na fala
    const NF = PRUB(700, 1, -0.01), N = texto(c.quem || '', { ...NF, base: 48, min: 40, piso: 36, larg: 470, maxLin: 1 }), SF = PRUB(500, 1.15, 0), S = texto(c.papel || '', { ...SF, base: 29, min: 26, piso: 24, larg: 470, maxLin: 2 });
