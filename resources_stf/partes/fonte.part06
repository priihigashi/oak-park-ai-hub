 if(s.type==='quote')h+=`<div class="q" style="font-size:${big(34)}px">“${esc(s.quote||s.title)}”</div>`;
 else if(s.type==='bars'){const mx=Math.max(...(s.bars||[]).map(b=>+b.value||0),1);h+=`<div class="t" style="font-size:68px;margin-bottom:32px">${esc(s.title)}</div>`;
  for(const b of s.bars||[])h+=`<div class="bar" style="font-size:40px;margin:16px 0"><span style="width:300px">${esc(b.label)}</span><i style="height:52px;width:${Math.round(480*(+b.value||0)/mx)}px;background:${fg}"></i><span>${esc(b.value)}</span></div>`}
 else h+=`<div class="t" style="font-size:92px">${esc(s.title)}</div>`;
 if(s.source)h+=`<div class="fonte" style="font-size:26px;left:108px;right:108px;bottom:48px">Fonte: ${esc(s.source)}</div>`;
 h+='</div>';
 const at=M.words.find(w=>t>=w.start&&t<=w.end)||M.words.filter(w=>w.start<=t).pop();
 if(at){const pg=M.words.filter(w=>w.page===at.page);const ls=[0,1].map(l=>pg.filter(w=>w.line===l).map(w=>w===at?`<b>${esc(w.text)}</b>`:esc(w.text)).join(' '));
  h+=`<div class="leg" style="font-size:52px;left:108px;right:108px;bottom:240px">${ls.join('<br>')}</div>`}
 P.innerHTML=h}
const fim=M.scenes[M.scenes.length-1].end;const sk=document.getElementById('seek');const tp=document.getElementById('tempo');
const mm=s=>Math.floor(s/60)+':'+String(Math.floor(s%60)).padStart(2,'0');
let BASE=1;const FAST_END=(M.scenes.find(x=>x.title==='Messias')||{end:0}).end,BOOST=0.05;
function loop(){{const r=+(BASE+(a.currentTime<FAST_END?BOOST:0)).toFixed(3);if(Math.abs(a.playbackRate-r)>1e-3)a.playbackRate=r;}desenhar(a.currentTime);sk.value=Math.round(1000*a.currentTime/fim);tp.textContent=mm(a.currentTime)+' / '+mm(fim);requestAnimationFrame(loop)}loop();
document.getElementById('play').onclick=e=>{if(a.paused){if(a.ended||a.currentTime>=fim-0.15)a.currentTime=0;a.play();e.target.textContent='❚❚ Pausa'}else{a.pause();e.target.textContent='▶ Play'}};
sk.oninput=()=>{a.currentTime=fim*sk.value/1000};
document.getElementById('reset').onclick=()=>{a.currentTime=0;a.play();document.getElementById('play').textContent='❚❚ Pausa'};
a.addEventListener('ended',()=>{document.getElementById('play').textContent='▶ Play'});
document.querySelectorAll('[data-j]').forEach(b=>b.onclick=()=>{a.currentTime=Math.max(0,Math.min(fim,a.currentTime+ +b.dataset.j))});
const V=document.getElementById('vel');[1,1.05,1.1,1.2,1.5,2,3].forEach(v=>{const b=document.createElement('button');b.textContent=String(v).replace('.',',')+'x';if(v===1)b.className='on';
 b.onclick=()=>{BASE=v;a.playbackRate=v;V.querySelectorAll('button').forEach(x=>x.className='');b.className='on'};V.appendChild(b)});
{const nt=document.createElement('div');nt.style.cssText='font:12px/1.3 JetBrains Mono,monospace;opacity:.7;margin-top:6px;width:100%';nt.textContent='Do início até o fim do card do Messias toca +0,05 acima da velocidade escolhida';V.after(nt);}
const cab=`${M.title} · ${M.id} · v${M.version} · ${location.href}\n\n`;
document.getElementById('copiar').onclick=()=>navigator.clipboard.writeText(cab+document.getElementById('notas').value);
document.querySelectorAll('[data-c]').forEach(b=>b.onclick=()=>navigator.clipboard.writeText(document.getElementById(b.dataset.c).innerText));
try{const k='notas-'+M.id+'-'+M.version;const n=document.getElementById('notas');n.value=localStorage.getItem(k)||'';n.oninput=()=>localStorage.setItem(k,n.value)}catch(e){}
</script>

